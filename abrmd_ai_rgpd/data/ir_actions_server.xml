<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Server Action — Pseudonymiser un res.partner -->
        <record id="action_pseudonymize_partner" model="ir.actions.server">
            <field name="name">RGPD — Pseudonymiser (réversible)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">action = env['abrmd.rgpd.anonymizer'].server_action_pseudonymize_partner()</field>
            <field name="groups_id" eval="[(4, ref('group_abrmd_rgpd_dpo'))]"/>
        </record>

        <!-- Server Action — Anonymiser DÉFINITIVEMENT un res.partner -->
        <record id="action_anonymize_partner" model="ir.actions.server">
            <field name="name">RGPD — Anonymiser DÉFINITIVEMENT (Art.17)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">action = env['abrmd.rgpd.anonymizer'].server_action_anonymize_partner()</field>
            <field name="groups_id" eval="[(4, ref('group_abrmd_rgpd_manager'))]"/>
        </record>

        <!-- Server Action — Log accès export depuis un res.partner -->
        <record id="action_log_partner_export" model="ir.actions.server">
            <field name="name">RGPD — Tracer un accès export</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
for record in records:
    env['abrmd.rgpd.access.log'].sudo().log_access(
        model='res.partner',
        res_id=record.id,
        log_type='export',
        description='Export manuel via Server Action — utilisateur %s' % env.user.name,
        legal_basis='legitimate_interest',
    )
            </field>
            <field name="groups_id" eval="[(4, ref('group_abrmd_rgpd_dpo'))]"/>
        </record>
    </data>
</odoo>
