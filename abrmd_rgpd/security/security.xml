<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Category -->
        <record id="module_category_abrmd_rgpd" model="ir.module.category">
            <field name="name">AI RGPD</field>
            <field name="description">Conformité RGPD AB Intelligence</field>
            <field name="sequence">95</field>
        </record>

        <!-- Group DPO -->
        <record id="group_abrmd_rgpd_dpo" model="res.groups">
            <field name="name">DPO — Délégué à la protection des données</field>
            <field name="category_id" ref="module_category_abrmd_rgpd"/>
            <field name="comment">Accès complet aux outils RGPD : registre, consentements, demandes, anonymisation, logs.</field>
        </record>

        <!-- Group Manager (full control + technical settings) -->
        <record id="group_abrmd_rgpd_manager" model="res.groups">
            <field name="name">Manager RGPD</field>
            <field name="category_id" ref="module_category_abrmd_rgpd"/>
            <field name="implied_ids" eval="[(4, ref('group_abrmd_rgpd_dpo'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record rule : DPO sees all RGPD records in own company -->
        <record id="rule_abrmd_rgpd_consent_company" model="ir.rule">
            <field name="name">RGPD Consent — multi-company</field>
            <field name="model_id" ref="model_abrmd_rgpd_consent"/>
            <field name="domain_force">[('create_uid.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_abrmd_rgpd_dpo'))]"/>
        </record>
    </data>
</odoo>
