<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence pour les références de demandes RGPD -->
        <record id="seq_abrmd_rgpd_request" model="ir.sequence">
            <field name="name">Référence demande RGPD</field>
            <field name="code">abrmd.rgpd.request</field>
            <field name="prefix">RGPD-REQ-</field>
            <field name="padding">5</field>
        </record>

        <!-- Cron : bascule des consentements expirés -->
        <record id="cron_abrmd_rgpd_consent_expire" model="ir.cron">
            <field name="name">RGPD — Expiration consentements</field>
            <field name="model_id" ref="model_abrmd_rgpd_consent"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron : alerte sur demandes à échéance -->
        <record id="cron_abrmd_rgpd_request_alerts" model="ir.cron">
            <field name="name">RGPD — Alertes échéance demandes</field>
            <field name="model_id" ref="model_abrmd_rgpd_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_deadlines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron : purge logs d'accès anciens -->
        <record id="cron_abrmd_rgpd_log_gc" model="ir.cron">
            <field name="name">RGPD — GC logs d'accès</field>
            <field name="model_id" ref="model_abrmd_rgpd_access_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_old_logs()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
