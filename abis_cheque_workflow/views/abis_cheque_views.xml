<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_abis_cheque_tree" model="ir.ui.view">
        <field name="name">abis.cheque.tree</field>
        <field name="model">abis.cheque</field>
        <field name="arch" type="xml">
            <list string="Chèques" decoration-success="state == 'cashed'"
                  decoration-danger="state == 'rejected'"
                  decoration-info="state == 'in_bank'">
                <field name="name"/>
                <field name="issue_date"/>
                <field name="partner_id"/>
                <field name="cheque_number"/>
                <field name="bank_name"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_abis_cheque_form" model="ir.ui.view">
        <field name="name">abis.cheque.form</field>
        <field name="model">abis.cheque</field>
        <field name="arch" type="xml">
            <form string="Chèque">
                <header>
                    <button name="action_emit" string="Émettre" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cash" string="Encaisser" type="object"
                            class="oe_highlight" invisible="state != 'in_bank'"/>
                    <button name="action_reject" string="Rejeter" type="object"
                            invisible="state not in ('emitted', 'in_bank')"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state in ('cancelled', 'cashed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,emitted,in_bank,cashed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="partner_id"/>
                            <field name="cheque_number"/>
                            <field name="bank_name"/>
                            <field name="bank_account"/>
                            <field name="drawer_name"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="invoice_id"/>
                            <field name="sale_order_id"/>
                            <field name="remise_id"/>
                            <field name="payment_id"/>
                        </group>
                    </group>
                    <group string="Workflow" col="4">
                        <field name="emitted_date" readonly="1"/>
                        <field name="deposit_date" readonly="1"/>
                        <field name="cashed_date" readonly="1"/>
                        <field name="rejected_date" readonly="1"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_abis_cheque" model="ir.actions.act_window">
        <field name="name">Chèques</field>
        <field name="res_model">abis.cheque</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
