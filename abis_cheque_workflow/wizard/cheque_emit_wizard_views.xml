<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cheque_emit_wizard_form" model="ir.ui.view">
        <field name="name">abis.cheque.emit.wizard.form</field>
        <field name="model">abis.cheque.emit.wizard</field>
        <field name="arch" type="xml">
            <form string="Émettre un chèque">
                <group>
                    <group>
                        <field name="invoice_id" readonly="1" invisible="not invoice_id"/>
                        <field name="sale_order_id" readonly="1" invisible="not sale_order_id"/>
                        <field name="partner_id"/>
                        <field name="drawer_name"/>
                        <field name="bank_name"/>
                        <field name="cheque_number"/>
                    </group>
                    <group>
                        <field name="issue_date"/>
                        <field name="amount"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_cheque" string="Créer le chèque"
                            type="object" class="oe_highlight"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cheque_emit_wizard" model="ir.actions.act_window">
        <field name="name">Émettre un chèque</field>
        <field name="res_model">abis.cheque.emit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
