<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_cheque_rejected" model="mail.template">
        <field name="name">ABIS Chèque — Notification de rejet</field>
        <field name="model_id" ref="model_abis_cheque"/>
        <field name="subject">Chèque {{ object.cheque_number }} rejeté — action requise</field>
        <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif;">
                <p>Bonjour <t t-out="object.partner_id.name"/>,</p>
                <p>
                    Le chèque numéro <strong t-out="object.cheque_number"/>
                    d'un montant de
                    <strong t-out="object.amount"/> €
                    a été rejeté par votre banque
                    (motif : <t t-out="object.rejection_reason"/>).
                </p>
                <p>
                    Merci de bien vouloir régulariser cette situation dans les
                    meilleurs délais. Vous pouvez nous contacter au
                    <t t-out="object.company_id.phone"/> ou par retour de mail.
                </p>
                <p>
                    Cordialement,<br/>
                    <t t-out="object.company_id.name"/>
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
