<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_abis_cheque" model="ir.sequence">
        <field name="name">Chèque ABIS</field>
        <field name="code">abis.cheque</field>
        <field name="prefix">CHQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_abis_cheque_remise" model="ir.sequence">
        <field name="name">Bordereau remise chèques ABIS</field>
        <field name="code">abis.cheque.remise</field>
        <field name="prefix">BORD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
