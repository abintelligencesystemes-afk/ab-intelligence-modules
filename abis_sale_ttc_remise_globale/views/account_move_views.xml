<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_abis_discount" model="ir.ui.view">
        <field name="name">account.move.form.abis.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <group string="Remise globale TTC" col="4">
                    <field name="abis_discount_ttc_mode"/>
                    <field name="abis_discount_ttc_amount"
                           invisible="abis_discount_ttc_mode != 'amount'"/>
                    <field name="abis_discount_ttc_percent"
                           invisible="abis_discount_ttc_mode != 'percent'"/>
                    <button name="action_apply_abis_discount_ttc"
                            string="Appliquer remise globale"
                            type="object" class="btn-primary"
                            invisible="abis_discount_ttc_mode == 'none' or abis_discount_applied"/>
                    <field name="abis_discount_applied"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
