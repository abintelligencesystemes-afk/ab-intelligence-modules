<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_abrmd_ai_invoice_cache_list" model="ir.ui.view">
        <field name="name">abrmd.ai.invoice.cache.list</field>
        <field name="model">abrmd.ai.invoice.cache</field>
        <field name="arch" type="xml">
            <list string="Cache OCR">
                <field name="create_date"/>
                <field name="filename"/>
                <field name="file_hash"/>
                <field name="file_size_kb"/>
                <field name="partner_id"/>
                <field name="hit_count"/>
                <field name="last_hit_date"/>
                <field name="cost_usd" sum="Total coût épargné"/>
                <field name="model_used"/>
                <field name="mode"/>
            </list>
        </field>
    </record>

    <record id="view_abrmd_ai_invoice_cache_form" model="ir.ui.view">
        <field name="name">abrmd.ai.invoice.cache.form</field>
        <field name="model">abrmd.ai.invoice.cache</field>
        <field name="arch" type="xml">
            <form string="Cache OCR">
                <sheet>
                    <group>
                        <group>
                            <field name="file_hash"/>
                            <field name="filename"/>
                            <field name="mime_type"/>
                            <field name="file_size_kb"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="move_id"/>
                            <field name="hit_count"/>
                            <field name="last_hit_date"/>
                        </group>
                    </group>
                    <group string="Méta extraction">
                        <field name="cost_usd"/>
                        <field name="tokens_in"/>
                        <field name="tokens_out"/>
                        <field name="model_used"/>
                        <field name="mode"/>
                    </group>
                    <separator string="JSON extrait"/>
                    <field name="extracted_json" widget="text" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_abrmd_ai_invoice_cache" model="ir.actions.act_window">
        <field name="name">Cache OCR factures</field>
        <field name="res_model">abrmd.ai.invoice.cache</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
