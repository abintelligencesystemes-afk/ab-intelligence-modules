<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Boutons OCR + Corriger & Apprendre sur la vue facture fournisseur -->
    <record id="view_account_move_form_inherit_abrmd_ai_achats" model="ir.ui.view">
        <field name="name">account.move.form.inherit.abrmd_ai_achats</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_abrmd_ai_ocr_from_attachment"
                        type="object"
                        string="OCR via OpenAI"
                        class="btn-primary"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"/>
                <button name="action_abrmd_ai_correct_and_learn"
                        type="object"
                        string="Corriger &amp; Apprendre"
                        class="btn-secondary"
                        invisible="not abrmd_ai_scan_id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="OCR AI Achats (AB Intelligence)"
                       invisible="not abrmd_ai_scan_id">
                    <field name="abrmd_ai_scan_id" readonly="1"/>
                    <field name="abrmd_ai_source" readonly="1"/>
                    <field name="abrmd_ai_cost_usd" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
