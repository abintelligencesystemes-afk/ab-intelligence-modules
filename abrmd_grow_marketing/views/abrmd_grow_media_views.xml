<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== MEDIA KANBAN GALLERY ===================== -->
    <record id="view_abrmd_grow_media_kanban" model="ir.ui.view">
        <field name="name">abrmd.grow.media.kanban</field>
        <field name="model">abrmd.grow.media</field>
        <field name="arch" type="xml">
            <kanban sample="1" class="o_kanban_small_column">
                <field name="name"/>
                <field name="mimetype"/>
                <field name="size_kb"/>
                <field name="source"/>
                <field name="is_image"/>
                <field name="is_video"/>
                <field name="usage_count"/>
                <field name="thumbnail"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image_fill_left o_kanban_image_full"
                                 t-if="record.thumbnail.raw_value">
                                <img t-att-src="kanban_image('abrmd.grow.media', 'thumbnail', record.id.raw_value)"
                                     alt="Vignette"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <span class="badge text-bg-info">
                                        <field name="mimetype"/>
                                    </span>
                                    <span class="badge text-bg-secondary">
                                        <field name="source"/>
                                    </span>
                                </div>
                                <div>
                                    <small>
                                        <field name="size_kb"/> KB —
                                        <field name="usage_count"/> usage(s)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_abrmd_grow_media_list" model="ir.ui.view">
        <field name="name">abrmd.grow.media.list</field>
        <field name="model">abrmd.grow.media</field>
        <field name="arch" type="xml">
            <list string="Bibliothèque médias" sample="1">
                <field name="create_date" optional="hide"/>
                <field name="name"/>
                <field name="mimetype"/>
                <field name="size_kb"/>
                <field name="source" widget="badge"/>
                <field name="is_image" optional="hide"/>
                <field name="is_video" optional="hide"/>
                <field name="usage_count"/>
                <field name="product_ids" widget="many2many_tags" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_abrmd_grow_media_form" model="ir.ui.view">
        <field name="name">abrmd.grow.media.form</field>
        <field name="model">abrmd.grow.media</field>
        <field name="arch" type="xml">
            <form string="Média Grow">
                <sheet>
                    <field name="thumbnail" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du média…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="filename"/>
                            <field name="mimetype" readonly="1"/>
                            <field name="size_kb" readonly="1"/>
                            <field name="source"/>
                            <field name="is_image" readonly="1"/>
                            <field name="is_video" readonly="1"/>
                            <field name="usage_count"/>
                        </group>
                        <group>
                            <field name="file" widget="binary" filename="filename"/>
                            <field name="file_url" placeholder="https://… (lien externe)"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tags &amp; produits" name="tags_page">
                            <group>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': False}"/>
                                <field name="product_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Posts utilisant ce média" name="posts_page">
                            <field name="post_ids" readonly="1">
                                <list>
                                    <field name="title"/>
                                    <field name="canal"/>
                                    <field name="scheduled_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_page">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_abrmd_grow_media_search" model="ir.ui.view">
        <field name="name">abrmd.grow.media.search</field>
        <field name="model">abrmd.grow.media</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="filename"/>
                <field name="tag_ids"/>
                <field name="product_ids"/>
                <separator/>
                <filter string="Images" name="f_image" domain="[('is_image', '=', True)]"/>
                <filter string="Vidéos" name="f_video" domain="[('is_video', '=', True)]"/>
                <filter string="iCloud" name="f_icloud" domain="[('source', '=', 'icloud')]"/>
                <filter string="Upload manuel" name="f_upload" domain="[('source', '=', 'upload')]"/>
                <filter string="Inutilisés" name="f_unused" domain="[('usage_count', '=', 0)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Source" name="g_source" context="{'group_by': 'source'}"/>
                    <filter string="MIME" name="g_mime" context="{'group_by': 'mimetype'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_abrmd_grow_media" model="ir.actions.act_window">
        <field name="name">Bibliothèque médias</field>
        <field name="res_model">abrmd.grow.media</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_abrmd_grow_media_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun média en bibliothèque.</p>
            <p>Importe depuis iCloud Drive (instance self-hosted) ou uploade manuellement.</p>
        </field>
    </record>

    <!-- ===================== MEDIA IMPORT WIZARD ===================== -->
    <record id="view_abrmd_grow_media_import_wizard_form" model="ir.ui.view">
        <field name="name">abrmd.grow.media.import.wizard.form</field>
        <field name="model">abrmd.grow.media.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer médias depuis dossier local">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Note :</strong> ce wizard ne fonctionne que sur instance
                        Odoo self-hostée (accès filesystem). Sur Odoo SaaS / Online,
                        utilise la création manuelle ou l'upload via le formulaire média.
                    </div>
                    <group>
                        <field name="folder_path"
                               placeholder="/Users/anthony/Library/Mobile Documents/com~apple~CloudDocs/RMD-AB-Knowledge/Media/Grow-Marketing/"/>
                        <field name="recursive"/>
                        <field name="max_files"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <group invisible="not imported_count and not skipped_count">
                        <field name="imported_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Lancer l'import"
                            class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_abrmd_grow_media_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer médias (iCloud / dossier local)</field>
        <field name="res_model">abrmd.grow.media.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_abrmd_grow_media"
              name="Bibliothèque médias"
              parent="menu_abrmd_grow_root"
              action="action_abrmd_grow_media"
              sequence="40"/>

    <menuitem id="menu_abrmd_grow_media_import"
              name="Importer depuis iCloud"
              parent="menu_abrmd_grow_config_root"
              action="action_abrmd_grow_media_import_wizard"
              sequence="20"/>

</odoo>
